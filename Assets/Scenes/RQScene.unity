--- !u!114 &1877554227
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1877554226}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 550c78b0d1e6aec42b9793afd37e44fa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RQResidentAmbassadorInteraction
  residentType: 0
  speakerName: Little Crab Bob
  aboutBaseDialogueLines:
  - speaker: Little Crab Bob
    translatedSpeaker: "\u5C0F\u8783\u87F9\u9C8D\u52C3"
    text: This is such a nice place...
    translatedText: "\u4F60\u7684\u57FA\u5730\u771F\u6F02\u4EAE..."
    sfxClip: {fileID: 8300000, guid: b6526d4dc0e5e0d448a923fa1bcd1103, type: 3}
    sfxVolumeScale: 1
  - speaker: Little Crab Bob
    translatedSpeaker: "\u5C0F\u8783\u87F9\u9C8D\u52C3"
    text: I wish Boss won't fire me...
    translatedText: "\u6211\u5E0C\u671B\u8001\u677F\u4E0D\u4F1A\u7092\u4E86\u6211..."
    sfxClip: {fileID: 8300000, guid: b6526d4dc0e5e0d448a923fa1bcd1103, type: 3}
    sfxVolumeScale: 1
  - speaker: Little Crab Bob
    translatedSpeaker: "\u5C0F\u8783\u87F9\u9C8D\u52C3"
    text: Once we're done with this, I'll have to head back... There's a huge pile
      of trash waiting to be cleaned up, and if I get back too late, the boss is
      definitely going to be furious...
    translatedText: "\u6211\u4EEC\u6F14\u594F\u5B8C\u4E4B\u540E\uFF0C\u6211\u5F97\u7ACB\u9A6C\u8D76\u56DE\u53BB...\u8FD8\u6709\u597D\u591A\u5783\u573E\u6CA1\u5904\u7406\u5462...\u5982\u679C\u56DE\u53BB\u665A\u4E86\u8001\u677F\u80AF\u5B9A\u4F1A\u5927\u53D1\u96F7\u9706\u7684..."
    sfxClip: {fileID: 8300000, guid: b6526d4dc0e5e0d448a923fa1bcd1103, type: 3}
    sfxVolumeScale: 1
  aboutWhaleDialogueLines:
  - speaker: Little Crab Bob
    translatedSpeaker: "\u5C0F\u8783\u87F9\u9C8D\u52C3"
    text: Is that Mr.Jones? He is huge...
    translatedText: "\u90A3\u5C31\u662F\u743C\u65AF\u5148\u751F\u5417\uFF1F\u4ED6\u53EF\u771F\u5927..."
    sfxClip: {fileID: 8300000, guid: b6526d4dc0e5e0d448a923fa1bcd1103, type: 3}
    sfxVolumeScale: 1
  requestSeaCucumberEscortDialogueLines: []
  aboutCrabDialogueLines: []
  aboutDolphinDialogueLines:
  - speaker: Little Crab Bob
    translatedSpeaker: "\u5C0F\u8783\u87F9\u9C8D\u52C3"
    text: Dorothy? Isn't she the famous singer? I love her song...
    translatedText: "\u6843\u4E50\u4E1D\uFF1F\u5929\u554A\uFF0C\u662F\u90A3\u4E2A\u5927\u6B4C\u661F\u6843\u4E50\u4E1D\u5417\uFF1F\u6211\u7231\u6B7B\u5979\u7684\u6B4C\u4E86..."
    sfxClip: {fileID: 8300000, guid: b6526d4dc0e5e0d448a923fa1bcd1103, type: 3}
    sfxVolumeScale: 1
  aboutSharkDialogueLines:
  - speaker: Little Crab Bob
    translatedSpeaker: "\u5C0F\u8783\u87F9\u9C8D\u52C3"
    text: Shrauk...I never met him before. He doesn't look like someone to mess with.
    translatedText: "\u6C99\u514B...\u6211\u4ECE\u6765\u6CA1\u6709\u89C1\u8FC7\u4ED6\uFF0C\u4ED6\u770B\u8D77\u6765\u53EF\u4E0D\u597D\u60F9\u3002"
    sfxClip: {fileID: 8300000, guid: b6526d4dc0e5e0d448a923fa1bcd1103, type: 3}
    sfxVolumeScale: 1
  aboutOctopusDialogueLines:
  - speaker: Little Crab Bob
    translatedSpeaker: "\u5C0F\u8783\u87F9\u9C8D\u52C3"
    text: That Octopus must been through a lot...
    translatedText: "\u90A3\u53EA\u7AE0\u9C7C\u4E00\u5B9A\u7ECF\u5386\u4E86\u4E0D\u5C11..."
    sfxClip: {fileID: 8300000, guid: b6526d4dc0e5e0d448a923fa1bcd1103, type: 3}
    sfxVolumeScale: 1
  aboutSeaCucumberDialogueLines:
  - speaker: Little Crab Bob
    translatedSpeaker: "\u5C0F\u8783\u87F9\u9C8D\u52C3"
    text: Dr. Luma is the best doctor, just a little bit too talktive...
    translatedText: "\u9646\u739B\u533B\u751F\u662F\u6574\u7247\u6D77\u6D0B\u91CC\u6700\u597D\u7684\u533B\u751F...\u5C31\u662F\u8BDD\u6709\u70B9\u591A\u3002"
    sfxClip: {fileID: 8300000, guid: b6526d4dc0e5e0d448a923fa1bcd1103, type: 3}
    sfxVolumeScale: 1
  symphonyRepeatDialogueLines:
  - speaker: Little Crab Bob
    translatedSpeaker: "\u5C0F\u8783\u87F9\u9C8D\u52C3"
    text: "I'm so nervous\u2026what if I messed up?"
    translatedText: "\u6211\u597D\u7D27\u5F20...\u4E07\u4E00\u6211\u641E\u7838\u4E86\u600E\u4E48\u529E\uFF1F"
    sfxClip: {fileID: 8300000, guid: b6526d4dc0e5e0d448a923fa1bcd1103, type: 3}
    sfxVolumeScale: 1
  randomSymphonyRepeatDialogueBlocks: []
  repeatDialogueLines:
  - speaker: Little Crab Bob
    translatedSpeaker: "\u5C0F\u8783\u87F9\u9C8D\u52C3"
    text: "I hope there will be less trash after we play this\u2026"
    translatedText: "\u5E0C\u671B\u6F14\u594F\u5B8C\u4E4B\u540E\u6D77\u91CC\u80FD\u5C11\u70B9\u5783\u573E..."
    sfxClip: {fileID: 8300000, guid: b6526d4dc0e5e0d448a923fa1bcd1103, type: 3}
    sfxVolumeScale: 1
  randomRepeatDialogueBlocks: []
