  postCrabQuestDialogueLines:
  - speaker: Seahorse
    text: Mr. Jones!
  - speaker: Mr. Jones
    text: ...
  - speaker: Seahorse
    text: Mr. Jones?
  - speaker: Mr. Jones
    text: ...
  - speaker: Mr. Jones
    text: "..\u2026\u2026(gasp)"
  - speaker: Seahorse
    text: MR.JONES!!!!
  - speaker: Mr. Jones
    text: (The heavy movement of the moving belt stirred up sand, and Mr. Jones opened
      his eyes.)
  repeatDialogueLines:
  - speaker: Mr. Jones
    text: ......
  randomRepeatDialogueBlocks: []
  postDolphinQuestDialogueLines:
  - speaker: Mr. Jones
    text: You saved the crabs!
  - speaker: Mr. Jones
    text: Now go help the dophins
  postOctopusQuestDialogueLines:
  - speaker: Mr. Jones
    text: You saved the dophins!
  - speaker: Mr. Jones
    text: Now go help the octopus.
  postSeaCucumberQuestDialogueLines:
  - speaker: Mr. Jones
    text: WOW you also found shark
  - speaker: Mr. Jones
    text: now go to sea cucumber
  - speaker: Mr. Jones
    text: let shark take you there
  afterSeaCucumberCompletedDialogueLines:
  - speaker: Mr. Jones
    text: You did them all
