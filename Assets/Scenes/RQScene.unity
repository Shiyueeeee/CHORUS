--- !u!114 &1775072457
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1775072456}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 550c78b0d1e6aec42b9793afd37e44fa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RQResidentAmbassadorInteraction
  residentType: 1
  speakerName: Dorothy The Dolphin
  aboutBaseDialogueLines:
  - speaker: Dorothy
    translatedSpeaker: "\u6843\u4E50\u4E1D"
    text: I haven't been here for a while...
    translatedText: "\u6211\u5F88\u4E45\u6CA1\u6765\u8FC7\u8FD9\u91CC\u4E86\u2026\u2026"
    sfxClip: {fileID: 8300000, guid: 2255922b1de63c94dbaa14dc1a9371b3, type: 3}
    sfxVolumeScale: 1
  - speaker: Dorothy
    translatedSpeaker: "\u6843\u4E50\u4E1D"
    text: The ocean is quiter, and louder...
    translatedText: "\u6D77\u6D0B\u53D8\u5F97\u66F4\u5B89\u9759\u4E86...\u4E5F\u66F4\u5608\u6742\u4E86\u3002"
    sfxClip: {fileID: 8300000, guid: 2255922b1de63c94dbaa14dc1a9371b3, type: 3}
    sfxVolumeScale: 1
  aboutWhaleDialogueLines:
  - speaker: Dorothy
    translatedSpeaker: "\u6843\u4E50\u4E1D"
    text: Jones. Still likes to sleep. Just like when we were young. (Laugh)
    translatedText: "\u743C\u65AF\uFF0C\u4F60\u8FD8\u548C\u5E74\u8F7B\u65F6\u4E00\u6837\uFF0C\u65F6\u4E0D\u65F6\u6253\u9F3E\u3002\uFF08\u7B11\uFF09"
    sfxClip: {fileID: 8300000, guid: 2255922b1de63c94dbaa14dc1a9371b3, type: 3}
    sfxVolumeScale: 0
  requestSeaCucumberEscortDialogueLines: []
  aboutCrabDialogueLines:
  - speaker: Dorothy
    translatedSpeaker: "\u6843\u4E50\u4E1D"
    text: "Hey little crab, Kirby may be a bit short-tempered, but he\u2019s a good
      crab\u2014diligent and responsible. It\u2019s all thanks to him that the ocean
      hasn\u2019t fallen even worse."
    translatedText: "\u563F\uFF0C\u5C0F\u8783\u87F9\uFF0C\u67EF\u6BD4\u867D\u7136\u6709\u70B9\u6025\u813E\u6C14\uFF0C\u4F46\u4ED6\u662F\u4E2A\u597D\u8783\u87F9\u2014\u2014\u52E4\u594B\u53C8\u8D1F\u8D23\u4EFB\u3002\u591A\u4E8F\u4E86\u4ED6\uFF0C\u5927\u6D77\u624D\u6CA1\u6709\u53D8\u5F97\u66F4\u7CDF\u3002"
    sfxClip: {fileID: 8300000, guid: 2255922b1de63c94dbaa14dc1a9371b3, type: 3}
    sfxVolumeScale: 1
  aboutDolphinDialogueLines: []
  aboutSharkDialogueLines:
  - speaker: Dorothy
    translatedSpeaker: "\u6843\u4E50\u4E1D"
    text: "Shrauk, you\u2019re finally not keeping to yourself so much anymore. It
      feels pretty good to be talking with everyone, doesn\u2019t it?"
    translatedText: "\u6C99\u514B\uFF0C\u4F60\u7EC8\u4E8E\u4E0D\u518D\u90A3\u4E48\u72EC\u6765\u72EC\u5F80\u4E86\u3002\u548C\u522B\u4EBA\u8BF4\u8BDD\u7684\u611F\u89C9\u4E0D\u9519\u5427\uFF1F"
    sfxClip: {fileID: 8300000, guid: 2255922b1de63c94dbaa14dc1a9371b3, type: 3}
    sfxVolumeScale: 1
  aboutOctopusDialogueLines:
  - speaker: Dorothy
    translatedSpeaker: "\u6843\u4E50\u4E1D"
    text: "Oliver\u2026Thank goodness that oil rig stop working\u2026it was very
      loud."
    translatedText: "\u5965\u5229\u7EF4\u5C14...\u6CB9\u4E95\u88AB\u5173\u95ED\u4E86\uFF0C\u771F\u662F\u592A\u597D\u4E86\u3002\u90A3\u4E2A\u4E1C\u897F\u5B9E\u5728\u662F\u592A\u5435\u4E86...\u54E6\u5BF9\u4E86\uFF0C\u5E0C\u671B\u4F60\u4E00\u5207\u90FD\u597D\u3002"
    sfxClip: {fileID: 8300000, guid: 2255922b1de63c94dbaa14dc1a9371b3, type: 3}
    sfxVolumeScale: 1
  aboutSeaCucumberDialogueLines:
  - speaker: Dorothy
    translatedSpeaker: "\u6843\u4E50\u4E1D"
    text: "Dr. Luma, thank you for everything you\u2019ve done for everyone."
    translatedText: "\u9646\u739B\u533B\u751F\uFF0C\u611F\u8C22\u4F60\u4E3A\u5927\u5BB6\u505A\u7684\u4E00\u5207\u3002"
    sfxClip: {fileID: 8300000, guid: 2255922b1de63c94dbaa14dc1a9371b3, type: 3}
    sfxVolumeScale: 1
  symphonyRepeatDialogueLines:
  - speaker: Dorothy
    translatedSpeaker: "\u6843\u4E50\u4E1D"
    text: Let human hear our voice.
    translatedText: "\u8BA9\u4EBA\u7C7B\u542C\u89C1\u6211\u4EEC\u7684\u58F0\u97F3\u5427\u3002"
    sfxClip: {fileID: 8300000, guid: 2255922b1de63c94dbaa14dc1a9371b3, type: 3}
    sfxVolumeScale: 0
  randomSymphonyRepeatDialogueBlocks: []
  repeatDialogueLines:
  - speaker: Dorothy
    translatedSpeaker: "\u6843\u4E50\u4E1D"
    text: "I stop singing a long time ago\u2026"
    translatedText: "\u6211\u5F88\u4E45\u4EE5\u524D\u5C31\u4E0D\u518D\u6B4C\u5531\u4E86..."
    sfxClip: {fileID: 8300000, guid: 2255922b1de63c94dbaa14dc1a9371b3, type: 3}
    sfxVolumeScale: 1
  randomRepeatDialogueBlocks: []
