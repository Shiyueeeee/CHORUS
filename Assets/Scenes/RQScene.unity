--- !u!114 &1006305871
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1006305870}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 550c78b0d1e6aec42b9793afd37e44fa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RQResidentAmbassadorInteraction
  residentType: 4
  speakerName: Dr.Luma
  aboutBaseDialogueLines:
  - speaker: Dr.Luma
    text: Wow wow wow, Dr.Luma love your base! Such a lovely place. Dr.Luma loves
      traveling.
    sfxClip: {fileID: 8300000, guid: 584766cdc20f4fb4088cf44c0e514ee1, type: 3}
    sfxVolumeScale: 1
  aboutWhaleDialogueLines:
  - speaker: Dr.Luma
    text: "Jones! My old friend. Why are you always tired? Dr.Luma never gets tired!
      I\u2019m full of enthusiasm for life, work, and my family\u2026"
    sfxClip: {fileID: 8300000, guid: 584766cdc20f4fb4088cf44c0e514ee1, type: 3}
    sfxVolumeScale: 0
  requestSeaCucumberEscortDialogueLines: []
  aboutCrabDialogueLines:
  - speaker: Dr.Luma
    text: "Bob! Glad to see you here. You guys must be busy! Last time Dr.Luma been
      to your place was like\u2026when was that? You probably wasn't born yet. (Laugh)"
    sfxClip: {fileID: 8300000, guid: 584766cdc20f4fb4088cf44c0e514ee1, type: 3}
    sfxVolumeScale: 1
  aboutDolphinDialogueLines:
  - speaker: Dr.Luma
    text: "Dorothy! Such a beautiful voice\u2026 When are you releasing new songs?
      Dr. Luma can't wait to hear it!"
    sfxClip: {fileID: 8300000, guid: 584766cdc20f4fb4088cf44c0e514ee1, type: 3}
    sfxVolumeScale: 1
  aboutSharkDialogueLines:
  - speaker: Dr.Luma
    text: Hey Shrauk, you need to protect your teeth. Stop by at Dr.Luma's clinic,
      Dr.Luma will give you free exam.
    sfxClip: {fileID: 8300000, guid: 584766cdc20f4fb4088cf44c0e514ee1, type: 3}
    sfxVolumeScale: 1
  aboutOctopusDialogueLines:
  - speaker: Dr.Luma
    text: "Oh poor Oliver\u2026Don't worry about your brothers. Dr.Luma already treat
      them before I come. Oh, this little sea horse helped me a lot! Thank you little
      guy."
    sfxClip: {fileID: 8300000, guid: 584766cdc20f4fb4088cf44c0e514ee1, type: 3}
    sfxVolumeScale: 1
  aboutSeaCucumberDialogueLines: []
  symphonyRepeatDialogueLines:
  - speaker: Dr.Luma
    text: "Dr. Luma can't wait to play! You didn't know but Dr.Luma is good at music!
      I was playing in a band called\u2026"
    sfxClip: {fileID: 8300000, guid: 584766cdc20f4fb4088cf44c0e514ee1, type: 3}
    sfxVolumeScale: 1
  randomSymphonyRepeatDialogueBlocks: []
  repeatDialogueLines:
  - speaker: Dr.Luma
    text: "Dr.Luma loves the temperature today\u2026hmm, is coral lesser than before?
      Oh Dr.Luma's goodness!! They are bleaching! Dr.Luma don't like this..."
    sfxClip: {fileID: 8300000, guid: 584766cdc20f4fb4088cf44c0e514ee1, type: 3}
    sfxVolumeScale: 1
  randomRepeatDialogueBlocks: []
