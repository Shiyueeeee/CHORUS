--- !u!114 &203975969
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 203975968}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 550c78b0d1e6aec42b9793afd37e44fa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RQResidentAmbassadorInteraction
  residentType: 3
  speakerName: Oliver The Octopus
  aboutBaseDialogueLines:
  - speaker: Oliver
    text: U-um, hi everyone...
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  aboutWhaleDialogueLines:
  - speaker: Oliver
    text: "T-that's Mr.Jones? He's m-my grandfather's friend\u2026"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 0
  requestSeaCucumberEscortDialogueLines: []
  aboutCrabDialogueLines:
  - speaker: Oliver
    text: Hey B-Bob, did K-Kirby bully you?
    sfxClip: {fileID: 8300000, guid: eaada9af74e14474ab780c7b4837a879, type: 3}
    sfxVolumeScale: 1
  aboutDolphinDialogueLines:
  - speaker: Oliver
    text: "D-Dorothy, glad to see you here\u2026Don't worry now, t-the oil rig won't
      bother you anymore."
    sfxClip: {fileID: 8300000, guid: eaada9af74e14474ab780c7b4837a879, type: 3}
    sfxVolumeScale: 1
  aboutSharkDialogueLines:
  - speaker: Oliver
    text: "S-Shrauk? That m-muscle\u2026"
    sfxClip: {fileID: 8300000, guid: eaada9af74e14474ab780c7b4837a879, type: 3}
    sfxVolumeScale: 1
  aboutOctopusDialogueLines: []
  aboutSeaCucumberDialogueLines:
  - speaker: Oliver
    text: "Dr.Luma! Thank you so much-much! You healed m-my friends and f-family\u2026"
    sfxClip: {fileID: 8300000, guid: eaada9af74e14474ab780c7b4837a879, type: 3}
    sfxVolumeScale: 1
  symphonyRepeatDialogueLines:
  - speaker: Oliver
    text: I-I'm ready! Let's d-do it!
    sfxClip: {fileID: 8300000, guid: eaada9af74e14474ab780c7b4837a879, type: 3}
    sfxVolumeScale: 0
  randomSymphonyRepeatDialogueBlocks: []
  repeatDialogueLines:
  - speaker: Oliver
    text: "I need to p-practice this song b-before we preform\u2026"
    sfxClip: {fileID: 8300000, guid: eaada9af74e14474ab780c7b4837a879, type: 3}
    sfxVolumeScale: 1
  randomRepeatDialogueBlocks: []
