--- !u!114 &1605839788
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1605839787}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 185e0ddae59eaf24cbf125484a1e0738, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RQSceneStateController
  crab: {fileID: 11407783}
  dolphinAmbassador: {fileID: 1617224564}
  sharkAmbassador: {fileID: 920342971}
  octopusAmbassador: {fileID: 54195999}
  seaCucumberAmbassador: {fileID: 165053596}
  mapPortal: {fileID: 85474048}
  seahorseSpeakerName: Seahorse
  firstEnterDialogueLines:
  - speaker: Seahorse
    translatedSpeaker: "\u6D77\u9A6C"
    text: Ughhhh!!! No!!!! My house!!!!!
    translatedText: "\u554A\u554A\u554A\u554A\u554A\u554A\uFF01\uFF01\u6211\u7684\u623F\u5B50\uFF01\uFF01\uFF01"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Seahorse
    translatedSpeaker: "\u6D77\u9A6C"
    text: The coral is bleaching and falling apart!
    translatedText: "\u73CA\u745A\u5728\u767D\u5316\uFF01\u53D8\u6210\u788E\u5757\u5F80\u4E0B\u6389\uFF01"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Seahorse
    translatedSpeaker: "\u6D77\u9A6C"
    text: Even my plants are died!
    translatedText: "\u5929\u554A\uFF0C\u5C31\u8FDE\u6211\u517B\u5728\u9633\u53F0\u7684\u7EFF\u690D\u4E5F\u67AF\u840E\u4E86\uFF01"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Seahorse
    translatedSpeaker: "\u6D77\u9A6C"
    text: What should I do?!
    translatedText: "\u8FD9\u7A76\u7ADF\u662F\u600E\u4E48\u4E00\u56DE\u4E8B\uFF1F\u6211\u8BE5\u600E\u4E48\u529E\u624D\u597D\uFF1F"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Seahorse
    translatedSpeaker: "\u6D77\u9A6C"
    text: "If this keeps going\u2026 everything here will die."
    translatedText: "\u5982\u679C\u7EE7\u7EED\u4E0B\u53BB\u2026\u2026\u4E00\u5207\u90FD\u4F1A\u6BC1\u6389\u7684\uFF01"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Seahorse
    translatedSpeaker: "\u6D77\u9A6C"
    text: ...
    translatedText: 
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Seahorse
    translatedSpeaker: "\u6D77\u9A6C"
    text: I know! Mr.Jones must know what to do.
    translatedText: "\u6211\u77E5\u9053\u4E86\uFF01\u743C\u65AF\u5148\u751F\u80AF\u5B9A\u6709\u529E\u6CD5\u3002"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
