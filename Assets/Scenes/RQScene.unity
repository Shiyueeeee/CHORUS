--- !u!114 &1898014371
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1898014370}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 550c78b0d1e6aec42b9793afd37e44fa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RQResidentAmbassadorInteraction
  residentType: 2
  speakerName: Shrauk The Shark
  aboutBaseDialogueLines:
  - speaker: Shrauk
    translatedSpeaker: "\u6C99\u514B"
    text: Heh.
    translatedText: "\u5475\u3002"
    sfxClip: {fileID: 8300000, guid: ad3e5973256fa3d42af3e0e769089381, type: 3}
    sfxVolumeScale: 1
  aboutWhaleDialogueLines:
  - speaker: Shrauk
    translatedSpeaker: "\u6C99\u514B"
    text: Sleepy Whales.
    translatedText: "\u55DC\u7761\u7684\u9CB8\u9C7C\u3002"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 0
  requestSeaCucumberEscortDialogueLines:
  - speaker: Sea horse
    translatedSpeaker: "\u6D77\u9A6C"
    text: Please take me to sea cucumber.
    translatedText: "\u8BF7\u5E26\u6211\u53BB\u6D77\u53C2\u90A3\u91CC\u3002"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk
    translatedSpeaker: "\u6C99\u514B"
    text: Heh. Lazy Jones.
    translatedText: "\u5475\uFF0C\u61D2\u60F0\u7684\u9CB8\u9C7C\u3002"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk
    translatedSpeaker: "\u6C99\u514B"
    text: Fine.
    translatedText: "\u884C\u5427\u3002"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  aboutCrabDialogueLines:
  - speaker: Shrauk
    translatedSpeaker: "\u6C99\u514B"
    text: Weak Crab.
    translatedText: "\u8783\u87F9\uFF0C\u771F\u5F31\u3002"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  aboutDolphinDialogueLines:
  - speaker: Shrauk
    translatedSpeaker: "\u6C99\u514B"
    text: "Instead of lecturing me, you\u2019d be better off saving your breath and
      taking care of your voice. Dorothy."
    translatedText: "\u6843\u4E50\u4E1D\uFF0C\u5C11\u628A\u773C\u73E0\u5B50\u653E\u5728\u6211\u8EAB\u4E0A\uFF0C\u7BA1\u597D\u4F60\u81EA\u5DF1\u3002"
    sfxClip: {fileID: 8300000, guid: ad3e5973256fa3d42af3e0e769089381, type: 3}
    sfxVolumeScale: 1
  aboutSharkDialogueLines: []
  aboutOctopusDialogueLines:
  - speaker: Shrauk
    translatedSpeaker: "\u6C99\u514B"
    text: Weak Octopus.
    translatedText: "\u7AE0\u9C7C\uFF0C\u771F\u5F31\u3002"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  aboutSeaCucumberDialogueLines:
  - speaker: Shrauk
    translatedSpeaker: "\u6C99\u514B"
    text: Weak Sea Cucumber. And annoying.
    translatedText: "\u6D77\u53C2\uFF0C\u771F\u5F31\u3002\u8FD8\u5570\u55E6\u3002"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  symphonyRepeatDialogueLines:
  - speaker: Shrauk
    translatedSpeaker: "\u6C99\u514B"
    text: Can we play that stupid song yet?
    translatedText: "\u8FD8\u80FD\u4E0D\u80FD\u6F14\u594F\u4E86\uFF1F"
    sfxClip: {fileID: 8300000, guid: ad3e5973256fa3d42af3e0e769089381, type: 3}
    sfxVolumeScale: 0
  randomSymphonyRepeatDialogueBlocks: []
  repeatDialogueLines:
  - speaker: Shrauk
    translatedSpeaker: "\u6C99\u514B"
    text: Boring.
    translatedText: "\u65E0\u804A\u3002"
    sfxClip: {fileID: 8300000, guid: ad3e5973256fa3d42af3e0e769089381, type: 3}
    sfxVolumeScale: 1
  randomRepeatDialogueBlocks: []
