  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RQSceneStateController
  crab: {fileID: 11407783}
  dolphinAmbassador: {fileID: 1617224564}
  sharkAmbassador: {fileID: 920342971}
  octopusAmbassador: {fileID: 54195999}
  seaCucumberAmbassador: {fileID: 165053596}
  mapPortal: {fileID: 85474048}
  seahorseSpeakerName: Seahorse
  firstEnterDialogueLines:
  - speaker: Seahorse
    text: Ughhhh!!! No!!!! My house!!!!!
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Seahorse
    text: The coral is bleaching and falling apart!
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Seahorse
    text: Even my plants are died!
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Seahorse
    text: What should I do?!
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Seahorse
    text: "If this keeps going\u2026 everything here will die."
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Seahorse
    text: ...
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Seahorse
    text: I know! Mr.Jones must know what to do.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
