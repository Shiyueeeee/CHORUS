  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OctopusSharkInteraction
  speakerName: Shark
  waitingDialogueLines:
  - speaker: Shrauk the Shark
    translatedSpeaker: "\u6C99\u514B"
    text: Hmph, these weaklings who can't even dodge a piece of trash would have
      been eliminated by the ocean currents long ago. Only a weird little seahorse
      like you would meddle in such trivial matters.
    translatedText: "\u54FC\uFF0C\u8FD9\u4E9B\u8FDE\u4E00\u5757\u5783\u573E\u90FD\u8EB2\u4E0D\u5F00\u7684\u5E9F\u7269\uFF0C\u65E9\u5C31\u88AB\u6D0B\u6D41\u51B2\u8D70\u5566\u3002\u53EA\u6709\u50CF\u4F60\u8FD9\u79CD\u602A\u5F02\u7684\u5C0F\u6D77\u9A6C\u624D\u4F1A\u63D2\u624B\u8FD9\u79CD\u9E21\u6BDB\u849C\u76AE\u7684\u5C0F\u4E8B\u3002"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
