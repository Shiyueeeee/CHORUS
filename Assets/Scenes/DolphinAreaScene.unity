      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[0].text
      value: "Wahhh\u2026! Mommy!!"
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[1].text
      value: "I can\u2019t find her\u2026I can\u2019t hear her anymore\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[2].text
      value: "Hey\u2014 hey, it\u2019s okay. Did you got separated from your mom?"
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[3].text
      value: "There was so much noise\u2026Everything got loud\u2026 then quiet\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[4].text
      value: "Hey\u2026 it\u2019s okay. I\u2019ll help you find her."
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[5].text
      value: "Stay close to me. Don\u2019t swim off, okay?"
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[6].text
      value: "Okay\u2026 I\u2019ll follow you."
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: rushDialogueLines.Array.data[0].text
      value: We are almost there.
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: rushDialogueLines.Array.data[1].text
      value: (Sobbing).
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: shipDialogueLines.Array.data[0].text
      value: "It\u2019s\u2026 scary here\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: shipDialogueLines.Array.data[1].text
      value: "I know. It's okay, you\u2019re not alone."
      objectReference: {fileID: 0}
