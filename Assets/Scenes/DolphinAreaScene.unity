--- !u!114 &2086893003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2086893001}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7be2b01900ec4fa2ba53c3748f846e83, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NarratorInteraction
  speakerName: Narrator
  dialogueLines:
  - speaker: Narrator
    translatedSpeaker: "\u65C1\u767D"
    text: 'The sound of intermittent sobbing could be heard in the distance. '
    translatedText: "\u8FDC\u5904\u4F20\u6765\u9635\u9635\u62BD\u6CE3\u58F0\u3002"
    sfxClip: {fileID: 8300000, guid: 3a6f426037e7df043a4f589baf0698f7, type: 3}
    sfxVolumeScale: 1
  - speaker: Narrator
    translatedSpeaker: "\u65C1\u767D"
    text: 'The little seahorse followed the sound and swam a little closer to its
      source. '
    translatedText: "\u5C0F\u6D77\u9A6C\u5FAA\u7740\u58F0\u97F3\u6E38\u4E86\u8FC7\u53BB\uFF0C\u79BB\u58F0\u97F3\u7684\u6765\u6E90\u53C8\u8FD1\u4E86\u4E00\u70B9\u3002"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Narrator
    translatedSpeaker: "\u65C1\u767D"
    text: And a little closer.
    translatedText: "\u53C8\u8FD1\u4E86\u4E00\u70B9\u3002"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Narrator
    translatedSpeaker: "\u65C1\u767D"
    text: ...
    translatedText: 
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  triggerOnSceneLoad: 1
  triggerDelaySeconds: 0
