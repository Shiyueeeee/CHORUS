      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[5].translatedText
      value: "\u8DDF\u7D27\u6211\uFF0C\u522B\u6E38\u4E22\u4E86\uFF0C\u597D\u5417\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[6].sfxVolumeScale
