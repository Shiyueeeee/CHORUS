      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: rushDialogueLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
