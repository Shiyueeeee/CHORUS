    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[0].translatedText
      value: "\u54C7\u554A\u554A\u554A\u2026\u2026\uFF01\uFF01\u5988\u5988\uFF01\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[1].translatedText
      value: "\u5988\u5988\u2026\u2026\u4F60\u5728\u54EA\u2026\u6211\u542C\u4E0D\u5230\u4E86\u2026\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[2].sfxVolumeScale
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[2].translatedText
      value: "\u563F\u2026\u2026\u563F\uFF0C\u5618\uFF0C\u4E0D\u54ED\u4E86\uFF0C\u6CA1\u4E8B\u7684\uFF0C\u4F60\u548C\u5988\u5988\u8D70\u6563\u4E86\u5417\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[3].sfxVolumeScale
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[3].translatedText
      value: "\u8FD9\u91CC\u7684\u566A\u97F3\u592A\u591A\u4E86\u2026\u2026\u597D\u5435\u597D\u5435\u2026\u2026\u7136\u540E\u53C8\u53D8\u5F97\u597D\u5B89\u9759\u2026\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[4].sfxVolumeScale
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[4].translatedText
      value: "\u6CA1\u5173\u7CFB\u7684\uFF0C\u5C0F\u5B9D\u8D1D\u513F\uFF0C\u6211\u4F1A\u5E2E\u4F60\u627E\u5230\u5988\u5988\u7684\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 7516793908042002129, guid: 1e4d995a4bae2f74598f4327c1f2c06d, type: 3}
      propertyPath: initDialogueLines.Array.data[5].sfxVolumeScale
