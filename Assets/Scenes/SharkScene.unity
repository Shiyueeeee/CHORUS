  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SharkEncounterManager
  waitingPhaseObjects:
  - {fileID: 1843597599}
  - {fileID: 427848304}
  attackPhaseObjects:
  - {fileID: 183485209}
  - {fileID: 1454997909}
  - {fileID: 712622227}
  - {fileID: 512767150}
  - {fileID: 780526265}
  quizPhaseObjects:
  - {fileID: 309142069}
  completedPhaseObjects: []
  completedDialogueSpeakerName: Shrauk the Shark
  completedDialogueLines:
  - speaker: Shrauk the Shark
    text: "\u2026So. You can think."
    sfxClip: {fileID: 8300000, guid: d70ff2240b045894a8c77aa8685ed6dd, type: 3}
    sfxVolumeScale: 0.8
  - speaker: Shrauk the Shark
    text: Not just swim.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: You understand the ocean. Enough.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: "If the waters rot\u2026everything starves."
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: "\u2026Fine. I\u2019ll join your hunt."
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: The octopus is far. Too far for you.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: Follow me.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: If you can keep up.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  nextSceneName: OctopusPathScene
  sceneIntroDialogueSpeakerName: Sea horse
  sceneIntroDialogueLines:
  - speaker: Narrator
    text: (The water suddenly shifts. A force pulls you deeper.)
    sfxClip: {fileID: 0}
    sfxVolumeScale: 0
  - speaker: Sea horse
    text: What's happening?!
    sfxClip: {fileID: 0}
    sfxVolumeScale: 0
