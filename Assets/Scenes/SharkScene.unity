    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: You got some skills..
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: Not useless.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: "But survival isn\u2019t enough."
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: Words matter now.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: Convince me.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
