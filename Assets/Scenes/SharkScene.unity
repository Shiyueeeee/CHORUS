--- !u!114 &1843597603
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1843597599}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8b2c251c8ea6bbd469d2934366ff5e96, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SharkInteraction
  speakerName: Shark
  encounterManager: {fileID: 1079634190}
  introDialogueLines:
  - speaker: Shrauk the Shark
    text: Heh, so small...and weak.
    sfxClip: {fileID: 8300000, guid: d70ff2240b045894a8c77aa8685ed6dd, type: 3}
    sfxVolumeScale: 0.8
  - speaker: Shrauk the Shark
    text: And you dare wander into my waters.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Sea Horse
    text: "Wait\u2014 I\u2019m not here to fight\u2014"
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: "Everything that enters\u2026is prey."
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Sea Horse
    text: 'No no no wait wait, I''m just passing by, I''m looking for the Octopus
      to get their melody, so we can play a symphony to call for human. '
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: That stupid song...? Still believe in it?
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: Even I do held a part...
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Sea Horse
    text: Wait, that means you could join us, we need your melody to save the ocean!
      And my house...
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: You think a song will save you?
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: Strength decides survival. Not sound.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: You want my part? Earn it.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Sea Horse
    text: How...?
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: Survive my hunt.
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: "Fail\u2026 and you feed the ocean."
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Sea Horse
    text: "\u2026Fine. I\u2019ll prove it."
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
  - speaker: Shrauk the Shark
    text: "\u2026Good. At least you\u2019re not boring."
    sfxClip: {fileID: 0}
    sfxVolumeScale: 1
